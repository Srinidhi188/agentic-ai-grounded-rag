# ==========================================
# Grounded RAG Chatbot - Environment Configuration
# ==========================================

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Knowledge Base PDF Source
PDF_URL=https://konverge.ai/pdf/Ebook-Agentic-AI.pdf
DATA_DIR=./data

# Vector Database (Pinecone)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=agentic-ai-rag
PINECONE_NAMESPACE=agentic-ai-ebook
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Embedding Configuration
# Options for EMBEDDING_PROVIDER: openai, gemini, local
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# LLM Configuration
# Options for LLM_PROVIDER: openai, gemini
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

# API Keys (Provide according to chosen provider)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# RAG & Retrieval Parameters
RETRIEVAL_TOP_K=4
# Minimum similarity score required to treat context as sufficient
RELEVANCE_THRESHOLD=0.65
# Maximum chunks to incorporate into generation prompt
MAX_CONTEXT_CHUNKS=4
